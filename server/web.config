<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <!-- Allows larger URLs, Query Strings, and Content Payloads -->
        <requestLimits maxAllowedContentLength="104857600" maxUrl="16384" maxQueryString="16384" />
      </requestFiltering>
    </security>
  </system.webServer>
  
  <system.web>
    <!-- Increase the maximum execution and request length attributes (in KB) -->
    <httpRuntime maxRequestLength="102400" maxUrlLength="16384" maxQueryStringLength="16384" />
  </system.web>
</configuration>
