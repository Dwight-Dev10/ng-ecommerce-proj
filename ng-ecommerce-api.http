@rootURL = http://localhost:5296

GET {{rootURL}}/api/ecommerce/
Accept: application/json

### Get all products
GET {{rootURL}}/api/products
Accept: application/json

### Get By Id
GET {{rootURL}}/api/products/99998888-7777-6666-5555-444433332222
Accept: application/json

### Create Product
POST {{rootURL}}/api/Products
Content-Type: application/json

{
    "product": {
      "id": "{{$guid}}",
      "name": "Wireless Bluetooth speakers",
      "description": "High-quality over-ear headphones with noise cancellation.",
      "price": 299.99,
      "imageUrl": "https://example.com/images/headphones.jpg",
      "rating": 3.2,
      "reviewCount": 130,
      "inStock": false,
      "category": "Electronics"
    }
}

### Updating existing Item
PUT {{rootURL}}/api/products/99998888-7777-6666-5555-444433332222
Content-Type: application/json

{
  "product": {
    "id": "99998888-7777-6666-5555-444433332222",
    "name": "Updated Reusable Water Bottle",
    "description": " The water sucks!! ",
    "price": 400.99,
    "imageUrl": "https://example.com/images/headphones.jpg",
    "rating": 5.2,
    "reviewCount": 10,
    "inStock": false,
    "category": "Home & Kitchen"
  }
}

### Delet Product
DELETE {{rootURL}}/api/products/99998888-7777-6666-5555-444433332222
Content-Type: application/json
